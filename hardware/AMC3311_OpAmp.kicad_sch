	(text "Voltage Error @ 140V for 1% tolerance\nDivider error: +-2% and +-2.8V difference"
		(exclude_from_sim no)
		(at 133.35 184.785 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "41c8eb6b-4653-4914-af4a-e000318e433a")
	)
	(text "Ratio = V_AMC3311_MAX / V_HV_MAX = 2.0V/140V = 0.014286V/V\n\nOp_amp_gain = 1.0\n\nV_Out_Diff = = Vin_HV * Ratio * Op_amp_gain = Vin_HV * 0.014286 * 1\n\nV_ADC = V_Out_Diff * Op_amp_gain"
		(exclude_from_sim no)
		(at 52.07 169.545 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "71c80ffa-d722-47d9-9561-3521a1ed90a4")
